{
  "name": "musik-klona-monorepo",
  "version": "1.0.0",
  "description": "Offline Music Player & YouTube Extractor - React Native + Node.js License Server",
  "scripts": {
    "build": "npm run build:web",
    "build:web": "npm --prefix mobile-app run build:web",
    "install:all": "npm install && npm --prefix mobile-app install && npm --prefix license-server install",
    "start:server": "npm run dev --prefix license-server",
    "start:mobile": "npm run start --prefix mobile-app",
    "start:web": "npm run web --prefix mobile-app",
    "test:server": "npm run test --prefix license-server",
    "test:mobile": "npm run test --prefix mobile-app",
    "test": "npm run test:server && npm run test:mobile",
    "build:server": "npm run build --prefix license-server",
    "type-check:mobile": "npm run type-check --prefix mobile-app",
    "check-all": "npm run build:server && npm run type-check:mobile && npm test"
  },
  "keywords": [
    "react-native",
    "expo",
    "music-player",
    "offline-music",
    "youtube-extractor",
    "license-server",
    "device-binding"
  ],
  "author": "Antigravity Pair Programmer",
  "license": "UNLICENSED",
  "dependencies": {
    "expo": "^58.0.23",
    "jsonwebtoken": "^9.0.2",
    "react-dom": "19.3.0",
    "react": "19.3.0",
    "react-native": "0.88.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.11.0"
  }
}
